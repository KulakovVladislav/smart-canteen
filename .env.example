# Smart Canteen environment example (no secrets)

# AI-меню (необязательно). Пустой ключ — работа на сохранённом или встроенном меню.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_PROVIDER=gemini

# Telegram-бот
TELEGRAM_BOT_TOKEN=
# ID сотрудников кухни через запятую. Остальные пользователи считаются учениками.
TELEGRAM_ADMIN_IDS=

# Сводка для кухни: ожидаемое число питающихся
CANTEEN_EXPECTED_DINERS=500

# Планировщик утренней рассылки (по умолчанию 09:00)
CANTEEN_BROADCAST_HOUR=9
CANTEEN_BROADCAST_MINUTE=0

# Внешнее фото главного экрана бота. Пусто — локальный assets/bot/welcome.jpg
CANTEEN_BOT_IMAGE_URL=

# Код входа на сайт. Пусто — без кода, только локальный демонстрационный режим.
CANTEEN_WEB_ACCESS_CODE=
